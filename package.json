{
  "name": "line-ending",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Show and change the line ending used by the current editor.",
  "keywords": [
    "crlf",
    "lf",
    "eol",
    "newline",
    "cr"
  ],
  "repository": "https://github.com/lumine-code/line-ending",
  "bugs": {
    "url": "https://github.com/lumine-code/line-ending/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "lib",
    "menus",
    "spec",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "defaultLineEnding": {
      "title": "Default line ending",
      "description": "Line ending to use for new files",
      "type": "string",
      "enum": [
        "OS Default",
        "LF",
        "CRLF"
      ],
      "default": "OS Default"
    }
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^2.0.0": "consumeStatusBar"
      }
    }
  },
  "dependencies": {
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#fbdc47043786a15eb0ff38e650930f9c540dc9be"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
